---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('destinations'))
  .filter((entry) => !entry.id.startsWith('_'))
  .map((entry) => ({ ...entry, routeSlug: entry.id.replace(/\.md$/, '') }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));
const heroImages = import.meta.glob('../assets/destinations/*/hero.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;

const cards = entries.map((entry) => ({
  entry,
  localHero: heroImages[`../assets/destinations/${entry.routeSlug}/hero.png`]
}));
---

<BaseLayout title="Reiseziele">
  <main>
    <header class="page-header">
      <h1>Reisetagebuch</h1>
      <p>Alle Ziele auf einen Blick – filterbar nach bereits besuchten und geplanten Reisen.</p>
    </header>

    <section class="filter-controls" aria-label="Statusfilter">
      <button type="button" class="active" data-filter="alle">Alle</button>
      <button type="button" data-filter="besucht">Besucht</button>
      <button type="button" data-filter="geplant">Geplant</button>
    </section>

    <section class="destination-grid" id="destinationGrid">
      {cards.map(({ entry, localHero }) => (
        <article class="destination-card" data-status={entry.data.status}>
          <a href={`/${entry.routeSlug}/`}>
            <div class="hero-wrapper">
              {localHero ? (
                <Image src={localHero} alt={entry.data.heroImage.alt} widths={[480, 720, 960]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" />
              ) : (
                <img src={entry.data.heroImage.src} alt={entry.data.heroImage.alt} loading="lazy" />
              )}
            </div>
            <div class="card-content">
              <h2>{entry.data.title}</h2>
              <p>{entry.data.country}</p>
              <span class="badge">{entry.data.status}</span>
            </div>
          </a>
        </article>
      ))}
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('.destination-card');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');

        for (const current of buttons) {
          current.classList.toggle('active', current === button);
        }

        for (const card of cards) {
          const status = card.getAttribute('data-status');
          const shouldShow = filter === 'alle' || status === filter;
          card.toggleAttribute('hidden', !shouldShow);
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .page-header h1 {
    margin-bottom: 0.25rem;
  }

  .page-header p {
    margin-top: 0;
    color: var(--muted);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
  }

  .filter-controls button {
    border: 1px solid var(--border-color);
    background: var(--card-background);
    color: inherit;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }

  .filter-controls button.active {
    background: var(--surface-contrast);
    color: var(--surface);
    border-color: var(--surface-contrast);
  }

  .destination-grid {
    display: grid;
    gap: 1rem;
  }

  .destination-card {
    border: 1px solid var(--border-color);
    border-radius: 0.8rem;
    background: var(--card-background);
    overflow: hidden;
  }

  .destination-card a {
    text-decoration: none;
    display: block;
    height: 100%;
  }

  .hero-wrapper :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card-content {
    padding: 0.9rem;
  }

  .card-content h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .card-content p {
    margin: 0.35rem 0 0.7rem;
    color: var(--muted);
  }

  .badge {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.82rem;
    text-transform: capitalize;
  }

  @media (min-width: 700px) {
    .destination-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .destination-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
