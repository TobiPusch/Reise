---
import Base from "../layouts/Base.astro";
import { getDestinations, profileNumber, withWidth } from "../lib/destinations";
import BudgetRating from "../components/BudgetRating.astro";
import {
  BUDGET_LEVELS,
  BUDGET_NONE,
  CONTINENTS,
  STATUSES,
  STATUS_LABELS,
  budgetLabel,
  filterKey,
} from "../lib/taxonomy";

const destinations = await getDestinations();
const slugs = destinations.map((d) => d.id);

// Filter nur für Werte anbieten, die tatsächlich vorkommen.
const count = (pred: (d: (typeof destinations)[number]) => boolean) => destinations.filter(pred).length;
interface FilterOption {
  value: string;
  label: string;
  ariaLabel?: string;
  /** Budget-Stufe, wird als 💰-Skala dargestellt. */
  level?: number;
  n: number;
}

interface FilterGroup {
  key: string;
  label: string;
  options: FilterOption[];
  /** Ab wie vielen vorhandenen Werten der Filter angezeigt wird. */
  minOptions: number;
}

const budgetKey = (d: (typeof destinations)[number]) =>
  d.data.budget === undefined ? BUDGET_NONE : String(d.data.budget);

const filterGroups = (
  [
    {
      key: "kontinent",
      label: "Kontinent",
      minOptions: 2,
      options: CONTINENTS.map((c) => ({ value: filterKey(c), label: c, n: count((d) => d.data.continent === c) })),
    },
    {
      key: "status",
      label: "Status",
      minOptions: 2,
      options: STATUSES.map((st) => ({ value: st, label: STATUS_LABELS[st], n: count((d) => d.data.status === st) })),
    },
    {
      key: "budget",
      label: "Budget",
      // Sobald ein Ziel ein Budget hat, ist der Filter sinnvoll.
      minOptions: 1,
      options: [
        ...BUDGET_LEVELS.map((level) => ({
          value: String(level),
          label: budgetLabel(level),
          level,
          ariaLabel: budgetLabel(level),
          n: count((d) => d.data.budget === level),
        })),
        { value: BUDGET_NONE, label: "Ohne Angabe", n: count((d) => d.data.budget === undefined) },
      ],
    },
  ] satisfies FilterGroup[]
)
  .map((g) => ({ ...g, options: g.options.filter((o) => o.n > 0) }))
  .filter((g) => g.options.filter((o) => o.value !== BUDGET_NONE).length >= g.minOptions && g.options.length > 1);
---

<Base title="Reiseziele" description="Reise-Journal: Orte, auf die du wirklich Bock hast.">
  <script is:inline slot="head" define:vars={{ slugs }}>
    // Alte Hash-Links des Single-File-Originals (z.B. /#rom) auf die neuen Seiten umleiten.
    function redirectLegacyHash() {
      var hash = decodeURIComponent(location.hash.slice(1));
      if (!hash) return;
      if (slugs.indexOf(hash) !== -1) {
        location.replace("/" + hash + "/");
      } else if (hash === "index" || hash === "liste") {
        history.replaceState(null, "", location.pathname + location.search);
      }
    }
    redirectLegacyHash();
    window.addEventListener("hashchange", redirectLegacyHash);
  </script>

  <div class="index measure">
    <header>
      <p class="kicker">Reise-Journal</p>
      <h1>Reiseziele</h1>
      <p class="sub">
        Orte, auf die du wirklich Bock hast — mit dem, was dich daran konkret reizt. Jedes Profil ist
        ein eigenes Kapitel.
      </p>
    </header>

    {
      filterGroups.length > 0 && (
        <div class="filters" id="filters" hidden>
          {filterGroups.map((group) => (
            <div class="filter-group" role="group" aria-label={group.label} data-filter={group.key}>
              <span class="filter-label">{group.label}</span>
              <button type="button" class="chip" data-value="" aria-pressed="true">
                Alle
              </button>
              {group.options.map((o) => (
                <button
                  type="button"
                  class="chip"
                  data-value={o.value}
                  aria-pressed="false"
                  aria-label={"ariaLabel" in o ? `${o.ariaLabel} (${o.n})` : undefined}
                >
                  {"level" in o ? <BudgetRating value={o.level} /> : o.label}{" "}
                  <span class="chip-count">{o.n}</span>
                </button>
              ))}
            </div>
          ))}
          <p class="filter-result" id="filter-result" aria-live="polite" />
        </div>
      )
    }

    <div class="entries">
      {
        destinations.map((entry, i) => (
          <a
            class="entry"
            href={`/${entry.id}/`}
            data-kontinent={filterKey(entry.data.continent)}
            data-status={entry.data.status}
            data-budget={budgetKey(entry)}
          >
            <img
              src={withWidth(entry.data.heroImage.src, 900)}
              alt=""
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="status-badge" data-status={entry.data.status}>
              {STATUS_LABELS[entry.data.status]}
            </span>
            <div class="entry-content">
              <p class="entry-num">
                {profileNumber(entry, i)} · {entry.data.country}
              </p>
              <h2 class="entry-title">{entry.data.title}</h2>
              <p class="entry-hook">{entry.data.teaser}</p>
              {entry.data.budget !== undefined && (
                <BudgetRating value={entry.data.budget} class="entry-budget" />
              )}
            </div>
          </a>
        ))
      }

    
    </div>

    <footer>
      <p>
        Alle Fotos: Wikimedia Commons, verschiedene CC-Lizenzen (Nachweis jeweils auf der
        Unterseite).
      </p>
    </footer>
  </div>
</Base>

<script>
  // Filter nach Kontinent und Status; Auswahl steht in der URL (?kontinent=europa&status=geplant).
  const filtersEl = document.getElementById("filters");
  const resultEl = document.getElementById("filter-result");
  const emptyEl = document.getElementById("entry-empty");
  const placeholderEl = document.getElementById("entry-placeholder");
  const entries = [...document.querySelectorAll<HTMLAnchorElement>(".entry")];
  const groups = [...document.querySelectorAll<HTMLElement>(".filter-group")];

  function readSelection(): Map<string, string> {
    const params = new URLSearchParams(location.search);
    const selection = new Map<string, string>();
    for (const group of groups) {
      const key = group.dataset.filter;
      const value = key ? params.get(key) : null;
      const valid = value && group.querySelector(`.chip[data-value="${CSS.escape(value)}"]`);
      if (key && valid) selection.set(key, value);
    }
    return selection;
  }

  function apply(selection: Map<string, string>): void {
    for (const group of groups) {
      const active = selection.get(group.dataset.filter ?? "") ?? "";
      group.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
        chip.setAttribute("aria-pressed", String((chip.dataset.value ?? "") === active));
      });
    }

    let visible = 0;
    for (const entry of entries) {
      const match = [...selection].every(([key, value]) => entry.dataset[key] === value);
      entry.hidden = !match;
      if (match) visible++;
    }

    if (resultEl) resultEl.textContent = `${visible} von ${entries.length} Zielen`;
    if (emptyEl) emptyEl.hidden = visible > 0;
    if (placeholderEl) placeholderEl.hidden = selection.size > 0;
  }

  function writeSelection(selection: Map<string, string>): void {
    const params = new URLSearchParams(location.search);
    for (const group of groups) {
      const key = group.dataset.filter;
      if (!key) continue;
      const value = selection.get(key);
      if (value) params.set(key, value);
      else params.delete(key);
    }
    const query = params.toString();
    history.replaceState(null, "", location.pathname + (query ? `?${query}` : ""));
  }

  if (filtersEl) {
    filtersEl.hidden = false;
    filtersEl.addEventListener("click", (e) => {
      const chip = e.target instanceof Element ? e.target.closest<HTMLButtonElement>(".chip") : null;
      const key = chip?.closest<HTMLElement>(".filter-group")?.dataset.filter;
      if (!chip || !key) return;
      const selection = readSelection();
      const value = chip.dataset.value ?? "";
      if (value) selection.set(key, value);
      else selection.delete(key);
      writeSelection(selection);
      apply(selection);
    });
    apply(readSelection());
  }
</script>

<style>
  .index {
    padding: 34px 20px 60px;
  }

  .measure {
    max-width: 640px;
    margin: 0 auto;
  }

  header {
    margin-bottom: 40px;
  }

  .kicker {
    font-size: 13px;
    opacity: 0.55;
    margin: 0 0 8px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 44px;
    line-height: 1;
    margin: 0 0 14px;
  }

  .sub {
    font-size: 16px;
    line-height: 1.55;
    max-width: 46ch;
    opacity: 0.75;
    margin: 0;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }

  .filters[hidden] {
    display: none;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .filter-label {
    width: 100%;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
  }

  .chip {
    font-family: var(--font-body);
    font-size: 12.5px;
    padding: 5px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    opacity: 0.7;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  .chip:hover {
    opacity: 1;
  }

  .chip[aria-pressed="true"] {
    opacity: 1;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .chip-count {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  .filter-result {
    font-size: 12.5px;
    opacity: 0.55;
    margin: 4px 0 0;
  }

  .entry[hidden],
  .entry-placeholder[hidden],
  .entry-empty[hidden] {
    display: none;
  }

  .entry-empty {
    font-size: 14px;
    opacity: 0.6;
    margin: 0;
    padding: 30px 0;
    text-align: center;
  }

  @media (min-width: 560px) {
    .filter-label {
      width: auto;
      min-width: 76px;
    }
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .entry {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 200px;
    overflow: hidden;
    border-radius: 3px;
    text-decoration: none;
    color: var(--on-dark);
    background: #211d18;
  }

  .entry img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .entry:hover img {
    transform: scale(1.02);
  }

  .entry::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 18, 15, 0.05) 40%, rgba(20, 18, 15, 0.85) 100%);
  }

  .entry-content {
    position: relative;
    z-index: 1;
    padding: 18px 20px;
    width: 100%;
  }

  .entry-num {
    font-family: var(--font-serif);
    font-size: 14px;
    opacity: 0.75;
    margin: 0 0 2px;
  }

  .entry-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 32px;
    margin: 0 0 4px;
  }

  .entry-content :global(.entry-budget) {
    margin-top: 8px;
    font-size: 14px;
  }

  .entry-hook {
    font-size: 14px;
    opacity: 0.85;
    max-width: 38ch;
    margin: 0;
  }

  .status-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--on-dark);
    background: rgba(33, 29, 24, 0.55);
    backdrop-filter: blur(2px);
  }

  .status-badge[data-status="geplant"] {
    background: var(--status-geplant);
  }
  .status-badge[data-status="besucht"] {
    background: var(--status-besucht);
  }

  .entry-placeholder {
    border: 1.5px dashed var(--line);
    border-radius: 3px;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
    font-size: 14px;
  }

  footer {
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    opacity: 0.55;
    line-height: 1.6;
  }

  @media (min-width: 680px) {
    .entry {
      min-height: 240px;
    }
  }
</style>
