---
import Base from "../layouts/Base.astro";
import { getDestinations } from "../lib/destinations";
import type { DefaultItem } from "../scripts/liste-store";

// Standard-Einträge kommen aus der Content Collection.
const defaults: DefaultItem[] = (await getDestinations()).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  link: `/${entry.id}/`,
  hook: entry.data.teaser,
  bestZeit: entry.data.bestTime ?? "",
  status: entry.data.status,
}));

// JSON sicher in <script type="application/json"> einbetten.
const defaultsJson = JSON.stringify(defaults).replace(/</g, "\\u003c");
---

<Base title="Meine Liste" description="Status, Budget und beste Reisezeit pro Ziel.">
  <div class="liste measure">
    <header>
      <p class="kicker">Reise-Journal</p>
      <h1>Meine Liste</h1>
      <p class="sub">
        Status, Budget und beste Reisezeit pro Ziel — damit die nächste Urlaubsentscheidung keine
        große Sache mehr ist.
      </p>
    </header>

    <div class="summary" id="liste-summary" aria-live="polite"></div>

    <div class="checklist" id="liste-checklist">
      <noscript><p>Für „Meine Liste“ wird JavaScript benötigt.</p></noscript>
    </div>

    <form class="add-new" id="liste-new-form">
      <label class="visually-hidden" for="liste-new-input">Neues Ziel</label>
      <input type="text" id="liste-new-input" placeholder="Neues Ziel hinzufügen…" maxlength="60" />
      <button type="submit">Hinzufügen</button>
    </form>

    <footer>
      <p>Wird lokal in diesem Browser gespeichert.</p>
    </footer>
  </div>

  <script type="application/json" id="liste-defaults" set:html={defaultsJson} />
</Base>

<script>
  import {
    LABELS,
    STATUSES,
    isStatus,
    loadState,
    saveState,
    type DefaultItem,
    type EditableField,
    type ListStatus,
  } from "../scripts/liste-store";

  interface Item {
    id: string;
    title: string;
    link: string | null;
    hook: string;
    isCustom: boolean;
    status: ListStatus;
    budget: string;
    bestZeit: string;
  }

  const defaultsEl = document.getElementById("liste-defaults");
  const DEFAULTS: DefaultItem[] = defaultsEl?.textContent ? JSON.parse(defaultsEl.textContent) : [];

  const checklistEl = document.getElementById("liste-checklist");
  const summaryEl = document.getElementById("liste-summary");
  const formEl = document.getElementById("liste-new-form") as HTMLFormElement | null;
  const inputEl = document.getElementById("liste-new-input") as HTMLInputElement | null;

  function mergedItems(): Item[] {
    const state = loadState();
    const items: Item[] = DEFAULTS.map((d) => {
      const o = state.overrides[d.id] ?? {};
      return {
        id: d.id,
        title: d.title,
        link: d.link,
        hook: d.hook,
        isCustom: false,
        status: isStatus(o.status) ? o.status : d.status,
        budget: o.budget ?? "",
        bestZeit: o.bestZeit !== undefined && o.bestZeit !== "" ? o.bestZeit : d.bestZeit,
      };
    });
    for (const c of state.custom) {
      items.push({
        id: c.id,
        title: c.title,
        link: null,
        hook: "",
        isCustom: true,
        status: isStatus(c.status) ? c.status : "offen",
        budget: c.budget ?? "",
        bestZeit: c.bestZeit ?? "",
      });
    }
    return items;
  }

  function setField(id: string, isCustom: boolean, field: EditableField, value: string): void {
    const state = loadState();
    if (isCustom) {
      const item = state.custom.find((c) => c.id === id);
      if (item) item[field] = value;
    } else {
      const override = (state.overrides[id] ??= {});
      override[field] = value;
    }
    saveState(state);
  }

  function addCustom(rawTitle: string): void {
    const title = rawTitle.trim();
    if (!title) return;
    const state = loadState();
    const slug =
      title
        .toLowerCase()
        .replace(/[^a-z0-9äöüß]+/g, "-")
        .replace(/(^-|-$)/g, "") || "ziel";
    const existingIds = new Set([...DEFAULTS.map((d) => d.id), ...state.custom.map((c) => c.id)]);
    let id = slug;
    let n = 2;
    while (existingIds.has(id)) {
      id = `${slug}-${n}`;
      n++;
    }
    state.custom.push({ id, title, status: "offen", budget: "", bestZeit: "" });
    saveState(state);
  }

  function removeCustom(id: string): void {
    const state = loadState();
    state.custom = state.custom.filter((c) => c.id !== id);
    saveState(state);
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function render(): void {
    if (!checklistEl || !summaryEl) return;
    const items = mergedItems();

    const counts: Record<ListStatus, number> = { offen: 0, geplant: 0, gebucht: 0, besucht: 0 };
    for (const it of items) counts[it.status]++;

    summaryEl.innerHTML = STATUSES.map(
      (s) =>
        `<span class="stat"><span class="dot" style="background:var(--status-${s})"></span><strong>${counts[s]}</strong> ${LABELS[s]}</span>`,
    ).join("");

    checklistEl.innerHTML = items
      .map((it) => {
        const id = escapeHtml(it.id);
        const data = `data-id="${id}" data-custom="${it.isCustom}"`;
        const titleHtml = it.link
          ? `<a href="${escapeHtml(it.link)}">${escapeHtml(it.title)}</a>`
          : escapeHtml(it.title);
        const pills = STATUSES.map(
          (s) =>
            `<button type="button" class="status-pill" data-status="${s}" data-active="${it.status === s}" aria-pressed="${it.status === s}" ${data}>${LABELS[s]}</button>`,
        ).join("");
        const removeBtn = it.isCustom
          ? `<button type="button" class="item-remove" data-remove-id="${id}">Entfernen ×</button>`
          : "";
        const hookHtml = it.hook ? `<p class="item-hook">${escapeHtml(it.hook)}</p>` : "";
        return (
          `<div class="checklist-item">` +
          `<div class="item-head"><h2 class="item-title">${titleHtml}</h2>${removeBtn}</div>` +
          hookHtml +
          `<div class="status-row" role="group" aria-label="Status für ${escapeHtml(it.title)}">${pills}</div>` +
          `<div class="field-row">` +
          `<div class="field"><label for="budget-${id}">Budget</label><input id="budget-${id}" type="text" placeholder="z.B. 800–1200 €" value="${escapeHtml(it.budget)}" data-field="budget" ${data}></div>` +
          `<div class="field"><label for="zeit-${id}">Beste Reisezeit</label><input id="zeit-${id}" type="text" placeholder="z.B. Frühling" value="${escapeHtml(it.bestZeit)}" data-field="bestZeit" ${data}></div>` +
          `</div>` +
          `</div>`
        );
      })
      .join("");
  }

  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const pill = target.closest<HTMLElement>(".status-pill");
    if (pill) {
      const { id, custom, status } = pill.dataset;
      if (id && status) setField(id, custom === "true", "status", status);
      render();
      return;
    }

    const removeBtn = target.closest<HTMLElement>(".item-remove");
    if (removeBtn?.dataset.removeId) {
      removeCustom(removeBtn.dataset.removeId);
      render();
    }
  });

  document.addEventListener("change", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLInputElement)) return;
    const field = target.dataset.field;
    const id = target.dataset.id;
    if ((field === "budget" || field === "bestZeit") && id) {
      setField(id, target.dataset.custom === "true", field, target.value);
    }
  });

  formEl?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!inputEl) return;
    addCustom(inputEl.value);
    inputEl.value = "";
    render();
  });

  render();
</script>

<style>
  .liste {
    padding: 18px 20px 60px;
  }

  .measure {
    max-width: 680px;
    margin: 0 auto;
  }

  header {
    margin-bottom: 28px;
  }

  .kicker {
    font-size: 13px;
    opacity: 0.55;
    margin: 0 0 8px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 40px;
    line-height: 1;
    margin: 0 0 14px;
  }

  .sub {
    font-size: 15.5px;
    line-height: 1.55;
    max-width: 48ch;
    opacity: 0.75;
    margin: 0;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-bottom: 28px;
    padding: 14px 18px;
    background: var(--card);
    border-radius: 3px;
    font-size: 13.5px;
  }

  .summary:empty {
    display: none;
  }

  .summary :global(.stat) {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .summary :global(.dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .summary :global(strong) {
    font-variant-numeric: tabular-nums;
  }

  .checklist {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .checklist :global(.checklist-item) {
    background: var(--card);
    border-radius: 3px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .checklist :global(.item-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .checklist :global(.item-title) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 24px;
    margin: 0;
  }

  .checklist :global(.item-title a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .checklist :global(.item-title a:hover) {
    border-color: var(--ink);
  }

  .checklist :global(.item-remove) {
    background: none;
    border: none;
    color: var(--ink);
    opacity: 0.4;
    font-size: 13px;
    cursor: pointer;
    padding: 2px 4px;
    font-family: var(--font-body);
  }

  .checklist :global(.item-remove:hover) {
    opacity: 0.9;
  }

  .checklist :global(.item-hook) {
    font-size: 13.5px;
    opacity: 0.7;
    margin: -8px 0 0;
    max-width: 50ch;
  }

  .checklist :global(.status-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .checklist :global(.status-pill) {
    font-family: var(--font-body);
    font-size: 12.5px;
    padding: 5px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    opacity: 0.65;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease,
      border-color 0.15s ease;
  }

  .checklist :global(.status-pill:hover) {
    opacity: 1;
  }

  .checklist :global(.status-pill[data-active="true"]) {
    opacity: 1;
    color: var(--on-dark);
    border-color: transparent;
  }

  .checklist :global(.status-pill[data-status="offen"][data-active="true"]) {
    background: var(--status-offen);
  }
  .checklist :global(.status-pill[data-status="geplant"][data-active="true"]) {
    background: var(--status-geplant);
  }
  .checklist :global(.status-pill[data-status="gebucht"][data-active="true"]) {
    background: var(--status-gebucht);
  }
  .checklist :global(.status-pill[data-status="besucht"][data-active="true"]) {
    background: var(--status-besucht);
  }

  .checklist :global(.field-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .checklist :global(.field label) {
    display: block;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
    margin-bottom: 4px;
  }

  .checklist :global(.field input) {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    padding: 2px 0 5px;
  }

  .checklist :global(.field input:focus) {
    outline: none;
    border-color: var(--ink);
  }

  .checklist :global(.field input::placeholder) {
    color: var(--ink);
    opacity: 0.35;
  }

  .add-new {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    padding: 16px 18px;
    border: 1.5px dashed var(--line);
    border-radius: 3px;
  }

  .add-new input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
  }

  .add-new input:focus {
    outline: none;
  }

  .add-new input::placeholder {
    color: var(--ink);
    opacity: 0.4;
  }

  .add-new button {
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    border-radius: 999px;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .add-new button:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    opacity: 0.5;
    line-height: 1.6;
  }

  @media (min-width: 461px) {
    .checklist :global(.field-row) {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }

  @media (min-width: 680px) {
    h1 {
      font-size: 48px;
    }
  }
</style>
