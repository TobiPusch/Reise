---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const destinations = (await getCollection('destinations')).filter((entry) => !entry.id.startsWith('_'));

  return destinations.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, slug: entry.id.replace(/\.md$/, '') }
  }));
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const heroImages = import.meta.glob('../assets/destinations/*/hero.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const localHero = heroImages[`../assets/destinations/${slug}/hero.png`];
const paletteVars = {
  '--city-primary': entry.data.palette.primary,
  '--city-secondary': entry.data.palette.secondary,
  '--city-accent': entry.data.palette.accent,
  '--city-background': entry.data.palette.background
};
---

<BaseLayout title={`${entry.data.title} | Reisetagebuch`}>
  <main class="city-page" style={paletteVars}>
    <a href="/" class="back-link">← Zurück zur Übersicht</a>

    <header class="city-hero">
      <div class="city-hero-image">
        {localHero ? (
          <Image src={localHero} alt={entry.data.heroImage.alt} widths={[720, 960, 1280]} sizes="(max-width: 900px) 100vw, 80vw" format="webp" />
        ) : (
          <img src={entry.data.heroImage.src} alt={entry.data.heroImage.alt} loading="eager" />
        )}
      </div>
      <div class="city-meta">
        <p class="status">{entry.data.status}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.country}</p>
        {entry.data.heroImage.credit && <p class="credit">Bildnachweis: {entry.data.heroImage.credit}</p>}
      </div>
    </header>

    <section class="city-content">
      <Content />
    </section>

    <section>
      <h2>Highlights</h2>
      <div class="attraction-grid">
        {entry.data.attractions.map((attraction) => (
          <article class="attraction-card">
            <p class="category">{attraction.category}</p>
            <h3>{attraction.name}</h3>
            <p>{attraction.description}</p>
            {attraction.image && <img src={attraction.image} alt={attraction.name} loading="lazy" />}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .city-page {
    --city-primary: #1d3557;
    --city-secondary: #457b9d;
    --city-accent: #f4a261;
    --city-background: #f1faee;
    background: var(--city-background);
    color: var(--city-primary);
    border-radius: 1rem;
    padding: 1.4rem;
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .back-link {
    color: var(--city-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .city-hero {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 1.4rem;
  }

  .city-hero-image :global(img) {
    width: 100%;
    border-radius: 0.8rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .city-meta h1 {
    margin: 0.3rem 0;
  }

  .city-meta p {
    margin: 0;
  }

  .status {
    display: inline-block;
    text-transform: capitalize;
    background: color-mix(in srgb, var(--city-accent) 24%, white);
    color: var(--city-primary);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.85rem;
  }

  .credit {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--city-primary) 75%, black);
    font-size: 0.88rem;
  }

  .city-content :global(h2) {
    margin-top: 1.7rem;
    border-bottom: 2px solid color-mix(in srgb, var(--city-secondary) 45%, transparent);
    padding-bottom: 0.25rem;
  }

  .attraction-grid {
    display: grid;
    gap: 0.9rem;
  }

  .attraction-card {
    border: 1px solid color-mix(in srgb, var(--city-secondary) 35%, white);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--city-background) 80%, white);
    padding: 0.9rem;
  }

  .attraction-card h3 {
    margin: 0.2rem 0 0.4rem;
  }

  .attraction-card p {
    margin: 0;
  }

  .category {
    color: var(--city-secondary);
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.35rem;
  }

  .attraction-card img {
    margin-top: 0.65rem;
    border-radius: 0.55rem;
    width: 100%;
    object-fit: cover;
  }

  @media (min-width: 920px) {
    .city-hero {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }

    .attraction-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-color-scheme: dark) {
    .city-page {
      color: color-mix(in srgb, var(--city-primary) 35%, white);
      background: color-mix(in srgb, var(--city-background) 16%, #07080b);
    }

    .status,
    .attraction-card {
      background: color-mix(in srgb, var(--city-background) 18%, #0f1218);
      color: inherit;
    }
  }
</style>
