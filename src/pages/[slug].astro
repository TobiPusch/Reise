---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { getDestinations, profileNumber, type Destination } from "../lib/destinations";
import BudgetRating from "../components/BudgetRating.astro";
import { STATUS_LABELS } from "../lib/taxonomy";
import { themeFor, themeVars } from "../lib/themes";

export const getStaticPaths = (async () => {
  const destinations = await getDestinations();
  return destinations.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, number: profileNumber(entry, index) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Destination;
  number: string;
}

const { entry, number } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const theme = themeFor(entry.id);

const rootStyle = {
  "--primary": data.palette.primary,
  "--secondary": data.palette.secondary,
  "--accent": data.palette.accent,
  "--background": data.palette.background,
  "--text": data.palette.text,
  ...themeVars(theme),
};

const dateFormat = new Intl.DateTimeFormat("de-DE", { month: "long", year: "numeric" });

const footerText =
  data.photoCredits ?? (data.heroImage.credit ? `Titelbild: ${data.heroImage.credit}` : undefined);
---

<Base
  title={data.title}
  description={data.subtitle ?? data.teaser}
  navOverlay={theme.navOverlay}
  rootClass="city"
  rootStyle={rootStyle}
>
  <article>
    <header class="hero">
      <img src={data.heroImage.src} alt={data.heroImage.alt} fetchpriority="high" />
      <div class="hero-content">
        <div class="measure">
          <p class="kicker">Städteprofil · {number}</p>
          <h1 class="title">{data.title}</h1>
          {data.subtitle && <p class="hero-sub">{data.subtitle}</p>}
        </div>
      </div>
    </header>

    <div class="measure">
      <dl class="facts">
        <div>
          <dt>Land</dt>
          <dd>{data.country} · {data.continent}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{STATUS_LABELS[data.status]}{data.visitedAt && ` · ${dateFormat.format(data.visitedAt)}`}</dd>
        </div>
        {
          data.budget !== undefined && (
            <div>
              <dt>Budget</dt>
              <dd>
                <BudgetRating value={data.budget} />
              </dd>
            </div>
          )
        }
        {
          data.bestTime && (
            <div>
              <dt>Beste Reisezeit</dt>
              <dd>{data.bestTime}</dd>
            </div>
          )
        }
      </dl>

      <div class="prose">
        <Content />
      </div>

      {
        data.attractions.length > 0 && (
          <section class="attractions" aria-labelledby="attractions-title">
            <h2 id="attractions-title" class="attractions-title">
              Sehenswürdigkeiten
            </h2>
            <ul class="attractions-grid">
              {data.attractions.map((a) => (
                <li class="attraction">
                  {a.image && (
                    <img src={a.image.src} alt={a.image.alt} loading="lazy" decoding="async" />
                  )}
                  <div class="attraction-body">
                    <p class="attraction-category">{a.category}</p>
                    <h3 class="attraction-name">{a.name}</h3>
                    <p class="attraction-text">{a.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        footerText && (
          <footer class="city-footer">
            <p>{footerText}</p>
          </footer>
        )
      }
    </div>
  </article>

  <dialog class="lightbox" id="lightbox" aria-label="Bildansicht">
    <div class="lightbox-stage" id="lightbox-stage">
      <img id="lightbox-img" alt="" />
    </div>
    <p class="lightbox-caption" id="lightbox-caption"></p>
    <button type="button" class="lightbox-btn lightbox-close" data-action="close" aria-label="Schließen">✕</button>
    <button type="button" class="lightbox-btn lightbox-prev" data-action="prev" aria-label="Vorheriges Bild">‹</button>
    <button type="button" class="lightbox-btn lightbox-next" data-action="next" aria-label="Nächstes Bild">›</button>
  </dialog>
</Base>

<script>
  // Lightbox: Bilder im Text, in Karten und im Attraktionen-Grid antippen zum Vergrößern.
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const stage = document.getElementById("lightbox-stage");
  const bigImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const caption = document.getElementById("lightbox-caption");
  const images = [...document.querySelectorAll<HTMLImageElement>(".prose img, .attractions img")];
  let current = -1;

  /** Größere Variante derselben Wikimedia-Datei; SVGs (z.B. Netzpläne) in Originalqualität. */
  function largeSrc(src: string): string {
    if (/\.svg(\?|$)/i.test(src)) return src.replace(/\?width=\d+/, "");
    return src.replace(/([?&]width=)\d+/, (_, prefix: string) => `${prefix}2560`);
  }

  function captionFor(img: HTMLImageElement): string {
    const figcaption = img.closest("figure")?.querySelector("figcaption");
    if (figcaption) {
      const credit = figcaption.querySelector(".credit")?.textContent?.trim();
      const text = [...figcaption.childNodes]
        .filter((node) => !(node instanceof Element && node.classList.contains("credit")))
        .map((node) => node.textContent)
        .join("")
        .trim();
      return credit ? `${text} · ${credit}` : text;
    }
    const name = img.closest(".attraction")?.querySelector(".attraction-name");
    return name?.textContent?.trim() || img.alt;
  }

  function show(index: number): void {
    if (!dialog || !bigImg || !caption || images.length === 0) return;
    current = (index + images.length) % images.length;
    const img = images[current];
    if (!img) return;
    stage?.classList.remove("zoomed");
    bigImg.src = img.currentSrc || img.src; // sofort das kleine Bild zeigen …
    bigImg.alt = img.alt;
    const large = largeSrc(img.src); // … und dann in hoher Auflösung nachladen
    const loader = new Image();
    loader.onload = () => {
      if (images[current] === img) bigImg.src = large;
    };
    loader.src = large;
    caption.textContent = captionFor(img);
    if (!dialog.open) dialog.showModal();
  }

  images.forEach((img, i) => {
    img.classList.add("zoomable");
    img.tabIndex = 0;
    img.setAttribute("role", "button");
    img.setAttribute("aria-label", `${img.alt || "Bild"} vergrößern`);
    img.addEventListener("click", (e) => {
      e.preventDefault();
      show(i);
    });
    img.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        show(i);
      }
    });
  });

  dialog?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;
    if (action === "close") dialog.close();
    else if (action === "prev") show(current - 1);
    else if (action === "next") show(current + 1);
    else if (target === bigImg) stage?.classList.toggle("zoomed");
    else if (target === dialog || target === stage) dialog.close();
  });

  dialog?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });

  // Wischen links/rechts zum Blättern (nur in der nicht gezoomten Ansicht)
  let touchX: number | null = null;
  stage?.addEventListener("touchstart", (e) => {
    touchX = e.touches.length === 1 ? (e.touches[0]?.clientX ?? null) : null;
  });
  stage?.addEventListener("touchend", (e) => {
    const endX = e.changedTouches[0]?.clientX;
    if (touchX === null || endX === undefined || stage.classList.contains("zoomed")) return;
    const dx = endX - touchX;
    if (Math.abs(dx) > 50) show(dx < 0 ? current + 1 : current - 1);
    touchX = null;
  });

  dialog?.addEventListener("close", () => {
    stage?.classList.remove("zoomed");
    images[current]?.focus({ preventScroll: true });
  });
</script>

<style is:global>
  /* Light: Palette direkt; Dark: Hintergrund/Text getauscht, Akzente angepasst. */
  html.city {
    --page-bg: var(--background);
    --page-fg: var(--text);
    --on-dark: var(--background);
    --surface: var(--surface-light, color-mix(in srgb, var(--primary) 8%, var(--background)));
    --rule: color-mix(in srgb, var(--text) var(--rule-alpha), transparent);
    --chapter-num: var(--primary);
    --quote-color: var(--secondary);
    --quote-line: var(--quote-border);
  }

  @media (prefers-color-scheme: dark) {
    html.city {
      --page-bg: color-mix(in srgb, var(--text) 92%, black);
      --page-fg: var(--background);
      --surface: color-mix(in srgb, var(--background) 9%, var(--text));
      --rule: color-mix(in srgb, var(--background) 16%, transparent);
      --chapter-num: color-mix(in srgb, var(--primary) 75%, var(--background));
      --quote-color: color-mix(in srgb, var(--secondary) 40%, var(--background));
      --quote-line: color-mix(in srgb, var(--quote-border) 80%, var(--background));
    }
  }

  .city .measure {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 22px;
  }

  /* --- Hero --- */
  .city .hero {
    position: relative;
    min-height: var(--hero-min);
    display: flex;
    align-items: flex-end;
    background: var(--hero-bg);
    overflow: hidden;
  }

  .city .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--hero-opacity);
    filter: var(--hero-filter);
  }

  .city .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--hero-bg) 0%, transparent) 30%,
      color-mix(in srgb, var(--hero-shade) var(--hero-shade-alpha), transparent) 100%
    );
  }

  .city .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 28px 0 34px;
    color: var(--background);
  }

  .city .kicker {
    font-size: 13px;
    letter-spacing: 0.02em;
    opacity: 0.75;
    margin: 0 0 6px;
  }

  .city h1.title {
    font-family: var(--font-display);
    font-weight: var(--title-weight);
    font-size: var(--title-size);
    line-height: var(--title-leading);
    letter-spacing: var(--title-tracking);
    margin: 0 0 10px;
    overflow-wrap: anywhere;
  }

  .city .hero-sub {
    font-size: 15.5px;
    max-width: 40ch;
    opacity: 0.9;
    margin: 0;
  }

  /* --- Eckdaten --- */
  .city .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 22px 0 18px;
    border-bottom: 1px solid var(--rule);
    font-size: 13.5px;
  }

  .city .facts dt {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.5;
    margin-bottom: 2px;
  }

  .city .facts dd {
    margin: 0;
  }

  /* --- Text aus Markdown --- */
  .city .prose {
    counter-reset: chapter;
    padding-top: 32px;
  }

  .city .prose p {
    font-size: 16px;
    line-height: 1.65;
  }

  /* Intro: alles vor dem ersten Kapitel */
  .city .prose > p:not(h2 ~ p) {
    font-size: 17px;
    line-height: 1.6;
  }

  .city .prose > p.lead {
    font-family: var(--font-display);
    font-style: var(--lead-style);
    font-size: var(--lead-size);
    font-weight: var(--lead-weight);
    line-height: var(--lead-leading);
    margin-top: 0;
  }

  /* Kapitel: ## Überschrift mit Nummer und Trennlinie wie im Original */
  .city .prose h2 {
    counter-increment: chapter;
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 24px 0 16px;
    padding-top: 54px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-display);
    font-weight: var(--chapter-title-weight);
    font-size: var(--chapter-title-size);
    line-height: 1.2;
  }

  .city .prose h2::before {
    content: counter(chapter, decimal-leading-zero);
    flex: none;
    font-size: var(--chapter-num-size);
    font-weight: 400;
    font-style: normal;
    color: var(--chapter-num);
  }

  /* Unterabschnitte innerhalb eines Kapitels (### im Markdown) */
  .city .prose h3 {
    font-family: var(--font-display);
    font-weight: var(--chapter-title-weight);
    font-size: calc(var(--chapter-title-size) * 0.75);
    line-height: 1.25;
    margin: 36px 0 8px;
  }

  /* Unterpunkte als Karten: Bild, Titel, kurzer Text (<div class="items"> im Markdown) */
  .city .items {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 24px 0;
  }

  .city .item {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: 3px;
    overflow: hidden;
  }

  .city .item figure {
    margin: 0;
  }

  .city .item figure img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0;
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  /* Karten/Pläne vollständig zeigen statt beschneiden */
  .city .item-map figure img {
    object-fit: contain;
    background: #fff;
    padding: 8px;
  }

  .city .item figcaption {
    margin: 0;
    padding: 8px 16px 0;
  }

  .city .item-body {
    padding: 4px 16px 18px;
  }

  .city .prose .item h3 {
    margin: 10px 0 6px;
  }

  .city .prose .item p {
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  .city figure {
    margin: 22px 0;
  }

  .city figure img {
    width: 100%;
    display: block;
    border-radius: 2px;
  }

  .city figcaption {
    font-size: 12.5px;
    opacity: 0.55;
    margin-top: 7px;
    line-height: 1.5;
  }

  .city figcaption .credit {
    display: block;
    font-size: 11px;
    margin-top: 2px;
  }

  .city blockquote {
    margin: 26px 0;
    padding: 4px 0 4px 18px;
    border-left: 3px solid var(--quote-line);
    font-family: var(--font-display);
    font-style: var(--quote-style);
    font-weight: var(--quote-weight);
    font-size: var(--quote-size);
    line-height: 1.5;
    color: var(--quote-color);
  }

  .city blockquote p {
    font-size: inherit;
    line-height: inherit;
    margin: 0;
  }

  .city .note {
    background: var(--surface);
    border-radius: 3px;
    padding: 16px 18px;
    font-size: 14.5px;
    line-height: 1.55;
    margin: 22px 0;
  }

  .city .note strong {
    color: var(--chapter-num);
  }

  /* --- Sehenswürdigkeiten --- */
  .city .attractions {
    margin-top: 32px;
    padding-top: 54px;
    border-top: 1px solid var(--rule);
  }

  .city .attractions-title {
    font-family: var(--font-display);
    font-weight: var(--chapter-title-weight);
    font-size: var(--chapter-title-size);
    margin: 0 0 20px;
  }

  .city .attractions-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .city .attraction {
    background: var(--surface);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .city .attraction img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .city .attraction-body {
    padding: 14px 16px 16px;
  }

  .city .attraction-category {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--chapter-num);
    margin: 0 0 4px;
  }

  .city .attraction-name {
    font-family: var(--font-display);
    font-weight: var(--chapter-title-weight);
    font-size: 21px;
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .city .attraction-text {
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
    opacity: 0.85;
  }

  /* --- Lightbox --- */
  .city img.zoomable {
    cursor: zoom-in;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(12, 11, 10, 0.94);
    color: #efeae0;
  }

  .lightbox::backdrop {
    background: rgba(12, 11, 10, 0.6);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 12px 8px;
    overflow: auto;
  }

  .lightbox-stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    background: transparent;
  }

  /* Gezoomt: Bild in voller Größe, Ausschnitt per Scrollen/Wischen verschieben */
  .lightbox-stage.zoomed {
    display: block;
  }

  .lightbox-stage.zoomed img {
    max-width: none;
    max-height: none;
    width: max(200%, 1600px);
    cursor: zoom-out;
  }

  .lightbox-caption {
    margin: 0;
    padding: 10px 56px 18px;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    opacity: 0.8;
  }

  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: inherit;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .lightbox-close {
    top: 8px;
    right: 8px;
  }

  .lightbox-prev,
  .lightbox-next {
    bottom: 10px;
    font-size: 28px;
  }

  .lightbox-prev {
    left: 8px;
  }

  .lightbox-next {
    right: 8px;
  }

  /* --- Footer --- */
  .city .city-footer {
    margin-top: 60px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--rule);
    font-size: 12px;
    opacity: 0.5;
    line-height: 1.7;
  }

  @media (min-width: 600px) {
    .city .items {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 560px) {
    .city .attractions-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 680px) {
    .city h1.title {
      font-size: var(--title-size-lg);
    }
    .city .hero {
      min-height: var(--hero-min-lg);
    }
  }
</style>
